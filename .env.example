# Claves de API de los proveedores. Se necesita al menos una para que NEXA
# pueda responder. El enrutador prioriza los proveedores gratuitos (Google,
# Groq, OpenRouter) y usa OpenAI/Anthropic (de pago) solo como último
# recurso si están configurados. Con varias configuradas, el respaldo
# automático entra en juego si una falla.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# IDs de modelo por proveedor y nivel de costo (opcional). Si se omiten se
# usan valores por defecto razonables; ajústalos según el catálogo vigente
# de cada proveedor (los catálogos cambian seguido, sobre todo modelos
# "latest"/"preview" que se retiran sin aviso).
GOOGLE_MODEL_FAST=gemini-flash-lite-latest
GOOGLE_MODEL_GENERAL=gemini-flash-lite-latest
GOOGLE_MODEL_ADVANCED=gemini-flash-lite-latest

GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_GENERAL=openai/gpt-oss-120b
GROQ_MODEL_ADVANCED=openai/gpt-oss-120b

OPENROUTER_MODEL_FAST=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL_GENERAL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_ADVANCED=meta-llama/llama-3.3-70b-instruct:free

OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_GENERAL=gpt-4o
OPENAI_MODEL_ADVANCED=gpt-4.1

ANTHROPIC_MODEL_FAST=claude-3-5-haiku-latest
ANTHROPIC_MODEL_GENERAL=claude-sonnet-4-5
ANTHROPIC_MODEL_ADVANCED=claude-opus-4-1

# Modelo de generación de imágenes (requiere OPENAI_API_KEY; no hay
# generación de imágenes gratuita en ningún proveedor de esta lista).
OPENAI_IMAGE_MODEL=gpt-image-1
