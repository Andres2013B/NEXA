# Claves de API de los proveedores. Se necesita al menos una para que NEXA
# pueda responder; con las tres configuradas, el enrutador automático puede
# elegir el mejor modelo para cada tarea y usar respaldo entre proveedores.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# IDs de modelo por proveedor y nivel de costo (opcional). Si se omiten se
# usan valores por defecto razonables; ajústalos según el catálogo vigente
# de cada proveedor.
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_GENERAL=gpt-4o
OPENAI_MODEL_ADVANCED=gpt-4.1

ANTHROPIC_MODEL_FAST=claude-3-5-haiku-latest
ANTHROPIC_MODEL_GENERAL=claude-sonnet-4-5
ANTHROPIC_MODEL_ADVANCED=claude-opus-4-1

GOOGLE_MODEL_FAST=gemini-flash-lite-latest
GOOGLE_MODEL_GENERAL=gemini-flash-lite-latest
GOOGLE_MODEL_ADVANCED=gemini-flash-lite-latest

# Modelo de generación de imágenes (requiere OPENAI_API_KEY).
OPENAI_IMAGE_MODEL=gpt-image-1
